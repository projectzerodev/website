---
import ProjectCard from "../components/ProjectCard.astro";
import Layout from "../layouts/Layout.astro";
const projects = [
  {
    name: "Zinix",
    description:
      "Minimal open-source operating system made to prevent e-waste.",
    href: "https://github.com/projectzerodev/zinix",
  },
];
---

<Layout>
  <div class="content">
    <main>
      <!-- Projects Section -->
      <section id="projects">
        <h2 class="section-header">Projects</h2>
        <div class="section-content">
          {projects.map((project) => <ProjectCard {...project} />)}
        </div>
      </section>
    </main>
  </div>
</Layout>

<style>
  .content {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  #projects {
    padding: 1.5rem;
    max-width: 56rem;
    margin: auto;
  }

  .section-header {
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    color: oklch(0.45 0 0);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    letter-spacing: 0.025em;
  }

  .section-content {
    display: grid;
    gap: 1rem;
  }
</style>
