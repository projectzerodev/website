---
interface Props {
  name: string;
  description: string;
  href: string;
}

const { name, description, href } = Astro.props;
---

<a href={href} target="_blank" class="card">
  <div class="content">
    <div>
      <h3 class="name">{name}</h3>
      <p class="description">{description}</p>
    </div>
    <svg
      class="arrow-icon"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
        d="M7 17L17 7M17 7H7M17 7V17"></path>
    </svg>
  </div>
</a>

<style>
  .card {
    display: block;
    border: 1px solid oklch(0.88 0 0);
    padding: 1rem;
    background: oklch(1 0 0);
    transition: border-color 150ms;
  }

  .card:hover {
    border-color: oklch(0.15 0 0);
  }

  .content {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    align-items: flex-start;
  }

  .name {
    font-weight: 500;
    color: oklch(0.15 0 0);
  }

  .arrow-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: oklch(0.45 0 0);
    flex-shrink: 0;
  }

  .description {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    line-height: 1.625;
    color: oklch(0.45 0 0);
  }
</style>
